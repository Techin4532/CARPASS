nE2+PJ+iM+KyJ+HR4QYkAv1aLemPBMrb5C8G0nUaKr4dRy8nUXxM8Gfb4y1mP\ni5lIzYOWN9jbwxtU6jMgCDUCdYgRLF/DuIq6YJUAKxyrBFjhWCXACscqAVY4\nVgmwwrFKgBWOVQKscKwSYIVjlQArHKsEWOFYJcAKxyoBVjhWCbDCsUqAFY5V\nAqxwrBJghWOVACscTqUXMFQbgqu/xr2RUNqgug7PrtZwNm3eXPNKlFIcP3ok\nl0pOIFSDKx2jaWpuyW/Zuo1gmbyVZDFwdr3z3ppX4kXAGJu+eOIYxBs8DzXv\ns/GWzXrz1o34s16h0Xhw6qGa/bxg244dnD19krNHD4Pj0HAZvNaCDrh15y5u\nv+Md5LJLYdaq/8zq0h2NscTjcR760C/yxmuvMDQ4SBDUYYexKsJ1Xdbe1Muu\nu+/FcSRa3xg+Td30cRCEL3q8/33vxZi67tJSFYTbzYLvc8MIH+q8MMQYS/4G\nsJs3EhrcJV/FYrFKgBWOVQKscKwSYIVjlQArHA0elpuGtwjfsC2BW4FtS9uc\nxsCNQIAc8G+B7zL1ThgX+DzwZW6Me6wZbgQT8DvAU0x/IZAP/CHwR0vRoEZC\noxPgJPD1ec5/kwZ8mWM90egEeJXwfbxz4Rxwuk5taUg0OgHarnJeAfE6tKNh\n0egEeADYOs/5+4CNdWpLQ6LRCRAndPYq3Ucz8EVCLbCKOdDoBAD4F8APgF2F\n/x3gXuAfgJ9bqkY1Cuo5Rq5lCtCHgF8gNAkW2F3Dum4o1FMD1Ho/WgV0Ux+n\nr8Hy2eZGPQlwpA51WGa9IbomqMe91AX1JMCfARdqXEea2vfO/YQBphsC9STA\nIeB9wAtALRLDfgz8FDhIKKRqIwv8FaFjebkG5S8J6j1Rcgx4ELgNuKnw3WIz\nLAVh7H8PIbEywLuAOwknhapRviXUXkcXWdayw/8H+JLaIwJoV94AAAAASUVO\nRK5CYII=\n"}},"microBlock-IDE_Ultrasonic-extension":{".gitattributes":"# Auto detect text files and perform LF normalization\n* text=auto\n","blocks":{"blocks.js":"Blockly.defineBlocksWithJsonArray([\n{\n  \"type\": \"ultrasonic_read\",\n  \"message0\": \"Ultrasonic trig pin: %1 echo pin: %2 read distance (cm)\",\n  \"args0\": [\n    {\n      \"type\": \"field_dropdown\",\n      \"name\": \"trig\",\n      \"options\": [\n        [\n          \"OUT1\",\n          \"26\"\n        ],\n        [\n          \"OUT2\",\n          \"27\"\n        ],\n        [\n          \"23\",\n          \"23\"\n        ],\n        [\n          \"19\",\n          \"19\"\n        ],\n        [\n          \"18\",\n          \"18\"\n        ],\n        [\n          \"VN\",\n          \"39\"\n        ]\n      ]\n    },\n    {\n      \"type\": \"field_dropdown\",\n      \"name\": \"echo\",\n      \"options\": [\n        [\n          \"IN1\",\n          \"32\"\n        ],\n        [\n          \"IN2\",\n          \"33\"\n        ],\n        [\n          \"IN3\",\n          \"34\"\n        ],\n        [\n          \"IN4\",\n          \"35\"\n        ],\n        [\n          \"23\",\n          \"23\"\n        ],\n        [\n          \"19\",\n          \"19\"\n        ],\n        [\n          \"18\",\n          \"18\"\n        ],\n        [\n          \"VN\",\n          \"39\"\n        ]\n      ]\n    }\n  ],\n  \"output\": \"Number\",\n  \"colour\": \"#004098\",\n  \"tooltip\": \"Get data from Sony Remote\",\n  \"helpUrl\": \"\"\n}\n]);\n\n\nBlockly.defineBlocksWithJsonArray([\n{\n  \"type\": \"ultrasonic_onepin_read\",\n  \"message0\": \"CARPASS Digital sensor pin %1 (0 clear / 1 detect)\",\n  \"args0\": [\n    {\n      \"type\": \"field_dropdown\",\n      \"name\": \"pin\",\n      \"options\": [[\"IN1\", \"32\"], [\"IN2\", \"33\"]]\n    }\n  ],\n  \"output\": \"Number\",\n  \"colour\": \"#004098\",\n  \"tooltip\": \"Single-wire ultrasonic distance for CARPASS\",\n  \"helpUrl\": \"\"\n},\n{\n  \"type\": \"carpass_ticks_ms\",\n  \"message0\": \"CARPASS time ticks ms\",\n  \"output\": \"Number\",\n  \"colour\": \"#004098\",\n  \"tooltip\": \"Current MicroPython ticks_ms value\",\n  \"helpUrl\": \"\"\n},\n{\n  \"type\": \"carpass_ticks_diff\",\n  \"message0\": \"CARPASS elapsed ms now %1 since %2\",\n  \"args0\": [\n    {\"type\": \"input_value\", \"name\": \"now\", \"check\": \"Number\"},\n    {\"type\": \"input_value\", \"name\": \"since\", \"check\": \"Number\"}\n  ],\n  \"inputsInline\": true,\n  \"output\": \"Number\",\n  \"colour\": \"#004098\",\n  \"tooltip\": \"Wrap-safe elapsed milliseconds\",\n  \"helpUrl\": \"\"\n}\n]);\n","generators.js":"Blockly.Python['ultrasonic_read'] = function(block) {\n  Blockly.Python.definitions_['import_ultrasonic'] = 'import Ultrasonic';\n\n  var dropdown_trig = block.getFieldValue('trig');\n  var dropdown_echo = block.getFieldValue('echo');\n\n  var code = `Ultrasonic.read(${dropdown_trig}, ${dropdown_echo})`;\n  return [code, Blockly.Python.ORDER_NONE];\n};\n\n\nBlockly.Python['ultrasonic_onepin_read'] = function(block) {\n  Blockly.Python.definitions_['import_ultrasonic'] = 'import Ultrasonic';\n  var pin = block.getFieldValue('pin');\n  return [`Ultrasonic.read_digital(${pin})`, Blockly.Python.ORDER_NONE];\n};\n\nBlockly.Python['carpass_ticks_ms'] = function(block) {\n  Blockly.Python.definitions_['import_time'] = 'import time';\n  return ['time.ticks_ms()', Blockly.Python.ORDER_NONE];\n};\n\nBlockly.Python['carpass_ticks_diff'] = function(block) {\n  Blockly.Python.definitions_['import_time'] = 'import time';\n  var now = Blockly.Python.valueToCode(block, 'now', Blockly.Python.ORDER_ATOMIC);\n  var since = Blockly.Python.valueToCode(block, 'since', Blockly.Python.ORDER_ATOMIC);\n  return [`time.ticks_diff(${now}, ${since})`, Blockly.Python.ORDER_NONE];\n};\n"},"extension.js":"({\n    name: \"Ultrasonic\", // Category Name\n    description: \"Get distance from HC-SR04p\",\n    author: \"microBlock\",\n    category: \"Sensors\",\n    version: \"1.0.0\",\n    icon: \"/static/icon.png\", // Category icon\n    color: \"#004098\", // Category color (recommend some blocks color)\n    blocks: [ // Blocks in Category\n        {\n            xml: `\n                <block type=\"ultrasonic_read\">\n                    <field name=\"trig\">26</field>\n                    <field name=\"echo\">32</field>\n                </block>\n            `\n        },\n        {\n            xml: `\n                <block type=\"ultrasonic_onepin_read\">\n                    <field name=\"pin\">32</field>\n                </block>\n            `\n        },\n        \"carpass_ticks_ms\",\n        {\n            xml: `\n                <block type=\"carpass_ticks_diff\">\n                    <value name=\"now\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n                    <value name=\"since\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n                </block>\n            `\n        }\n    ]\n});\n","modules":{"Ultrasonic.py":"from machine import Pin\nfrom machine import time_pulse_us\nfrom time import sleep_us\n\ndef read(trig_pin, echo_pin):\n    trigger = Pin(trig_pin, mode=Pin.OUT)\n    echo = Pin(echo_pin, mode=Pin.IN)\n\n    trigger.value(0)\n    sleep_us(5)\n    trigger.value(1)\n    sleep_us(10)\n    trigger.value(0)\n\n    try:\n        pulse_time = time_pulse_us(echo, 1, 1000000)\n        d = (pulse_time / 2) / 29.1\n        return int(d) if d < 400 else -1\n    except OSError as ex:\n        return -1\n\n\ndef read_onepin(pin_num):\n    pin = Pin(pin_num, mode=Pin.OUT)\n    pin.value(0)\n    sleep_us(2)\n    pin.value(1)\n    sleep_us(10)\n    pin.value(0)\n    pin.init(Pin.IN)\n    try:\n        pulse_time = time_pulse_us(pin, 1, 30000)\n        if pulse_time < 0:\n            # No echo means no object in measurable range.\n            # Return a large clear distance so the gate state can recover to IDLE.\n            return 999.0\n        distance = (pulse_time * 0.0343) / 2\n        if distance <= 0 or distance > 500:\n            return 999.0\n        return distance\n    except Exception:\n        return -1\n\n\ndef read_digital(pin_num):\n    return Pin(pin_num, mode=Pin.IN).value()\n"},"static":{"icon.png":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAHgAAAB4CAYAAAA5ZDbSAAAACXBIWXMAAC4j\nAAAuIwF4pT92AAALb2lUWHRYTUw6Y29tLmFkb2JlLnhtcAAAAAAAPD94cGFj\na2V0IGJlZ2luPSLvu78iIGlkPSJXNU0wTXBDZWhpSHpyZVN6TlRjemtjOWQi\nPz4gPHg6eG1wbWV0YSB4bWxuczp4PSJhZG9iZTpuczptZXRhLyIgeDp4bXB0\naz0iQWRvYmUgWE1QIENvcmUgNS42LWMxNDUgNzkuMTYzNDk5LCAyMDE4LzA4\nLzEzLTE2OjQwOjIyICAgICAgICAiPiA8cmRmOlJERiB4bWxuczpyZGY9Imh0\ndHA6Ly93d3cudzMub3JnLzE5OTkvMDIvMjItcmRmLXN5bnRheC1ucyMiPiA8\ncmRmOkRlc2NyaXB0aW9uIHJkZjphYm91dD0iIiB4bWxuczp4bXA9Imh0dHA6\nLy9ucy5hZG9iZS5jb20veGFwLzEuMC8iIHhtbG5zOmRjPSJodHRwOi8vcHVy\nbC5vcmcvZGMvZWxlbWVudHMvMS4xLyIgeG1sbnM6eG1wTU09Imh0dHA6Ly9u\ncy5hZG9iZS5jb20veGFwLzEuMC9tbS8iIHhtbG5zOnN0RXZ0PSJodHRwOi8v\nbnM